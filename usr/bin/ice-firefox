#!/usr/bin/env python3

import os
import shutil
import subprocess
import sys

if len(sys.argv) < 2:
    sys.exit("Usage: ice-firefox <url>")

url = sys.argv[1]

profileid = (url.replace('http://', '')
                .replace('https://', '')
                .replace('/', '_'))

base_dir = os.path.expanduser('~/.local/share/ice/firefox')
profile_path = os.path.join(base_dir, profileid)
chrome_path = os.path.join(profile_path, 'chrome')

os.makedirs(chrome_path, exist_ok=True)

with open(os.path.join(chrome_path, 'userChrome.css'), 'w') as css:
    css.write("#nav-bar, #identity-box, #tabbrowser-tabs, "
              "#TabsToolbar { visibility: collapse !important; }\n")

user_prefs = [
    ("browser.cache.disk.enable", "false"),
    ("browser.cache.disk.capacity", "0"),
    ("browser.cache.disk.filesystem_reported", "1"),
    ("browser.cache.disk.smart_size.enabled", "false"),
    ("browser.cache.disk.smart_size.first_run", "false"),
    ("browser.cache.disk.smart_size.use_old_max", "false"),
    ("browser.ctrlTab.previews", "true"),
    ("browser.tabs.warnOnClose", "false"),
    ("toolkit.legacyUserProfileCustomizations.stylesheets", "true"),
]

with open(os.path.join(profile_path, 'user.js'), 'w') as prefs:
    for key, value in user_prefs:
        prefs.write('user_pref("{0}", {1});\n'.format(key, value))

for resource in ('search.json.mozlz4', 'places.sqlite'):
    src = os.path.join('/usr/lib/peppermint/ice', resource)
    dst = os.path.join(profile_path, resource)
    if os.path.exists(src) and not os.path.exists(dst):
        shutil.copyfile(src, dst)

subprocess.run(['firefox', '-profile', profile_path, '-no-remote',
                '-new-instance', url])

shutil.rmtree(os.path.join(profile_path, 'cache2'), ignore_errors=True)
